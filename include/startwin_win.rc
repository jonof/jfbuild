#include <windows.h>
#include <commctrl.h>
#include <richedit.h>
#include "startwin_win.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_STARTWIN DIALOGEX 20, 40, 351, 238
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_CAPTION | WS_VISIBLE | WS_SYSMENU
CAPTION "Startup"
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    DEFPUSHBUTTON   "&Start", IDOK, 229, 216, 55, 15, 0, WS_EX_LEFT
    PUSHBUTTON      "&Cancel", IDCANCEL, 289, 216, 55, 15, 0, WS_EX_LEFT
    CONTROL         "", IDC_STARTWIN_TABCTL, WC_TABCONTROL, WS_TABSTOP | WS_CLIPSIBLINGS, 87, 7, 257, 198, WS_EX_LEFT | WS_EX_CONTROLPARENT
    AUTOCHECKBOX    "&Always show configuration on start", IDC_ALWAYSSHOW, 12, 220, 140, 8, WS_TABSTOP, WS_EX_LEFT
    CONTROL         IDB_BMP, IDC_STATIC, WC_STATIC, SS_BITMAP, 22, 7, 43, 39, WS_EX_LEFT
    CTEXT           "App Name", IDC_STARTWIN_APPTITLE, 6, 52, 77, 15, SS_CENTER, WS_EX_LEFT
    LTEXT           "Version xxxxxxxx", IDC_STARTWIN_APPVERSION, 6, 185+4, 77, 8, SS_LEFT | SS_ENDELLIPSIS, WS_EX_LEFT
    CONTROL         "<A HREF=""about:blank"">Website</A>", IDC_STARTWIN_APPLINK, WC_LINK, WS_TABSTOP, 6, 193+4, 77, 15, WS_EX_LEFT
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_PAGE_CONFIG DIALOGEX 0, 0, 252, 182
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILDWINDOW
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    // IDC_CONTROL_FEATURE_xxx controls overlap all the controls they relate to and
    // are the bounds used to adjust the layout for disabled features.

    CONTROL         "", IDC_CONFIG_FEATURE_VIDEO, WC_STATIC, 0, 0, 7, 252, 33
    LTEXT           "&Video mode:", IDC_STATIC, 7, 9, 52, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    COMBOBOX        IDC_VMODE3D, 75, 7, 115, 99, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST, WS_EX_LEFT
    AUTOCHECKBOX    "&Fullscreen", IDC_FULLSCREEN, 75, 23, 49, 10, WS_TABSTOP, WS_EX_LEFT
    COMBOBOX        IDC_DISPLAY, 129, 23, 95, 99, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST, WS_EX_LEFT

    CONTROL         "", IDC_CONFIG_FEATURE_EDITOR, WC_STATIC, 0, 0, 40, 252, 18
    LTEXT           "&Editor mode:", IDC_STATIC, 7, 42, 52, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    COMBOBOX        IDC_VMODE2D, 75, 40, 95, 99, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST, WS_EX_LEFT

    CONTROL         "", IDC_CONFIG_FEATURE_AUDIO, WC_STATIC, 0, 0, 58, 252, 18
    LTEXT           "S&ound quality:", IDC_STATIC, 7, 60, 52, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    COMBOBOX        IDC_SOUNDQUALITY, 75, 58, 95, 99, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST, WS_EX_LEFT

    CONTROL         "", IDC_CONFIG_FEATURE_INPUT, WC_STATIC, 0, 0, 76, 252, 13
    LTEXT           "Input devices:", IDC_STATIC, 7, 76, 52, 9, WS_CHILD | WS_VISIBLE, WS_EX_LEFT
    AUTOCHECKBOX    "Mo&use", IDC_USEMOUSE, 75, 76, 40, 8, WS_TABSTOP, WS_EX_LEFT
    AUTOCHECKBOX    "Cont&roller", IDC_USEJOYSTICK, 115, 76, 46, 8, WS_TABSTOP, WS_EX_LEFT

    CONTROL         "", IDC_CONFIG_FEATURE_NETWORK, WC_STATIC, 0, 0, 90, 252, 78
    AUTORADIOBUTTON "Sin&gle player game", IDC_SINGLEPLAYER, 12, 96, 95, 8, WS_GROUP | WS_TABSTOP, WS_EX_LEFT
    AUTORADIOBUTTON "Joi&n multi-player game", IDC_JOINMULTIPLAYER, 12, 111, 95, 8, 0, WS_EX_LEFT
    AUTORADIOBUTTON "Hos&t multi-player game", IDC_HOSTMULTIPLAYER, 12, 141, 95, 8, 0, WS_EX_LEFT
    LTEXT           "Host a&ddress:", IDC_STATIC, 27, 126, 70, 9, SS_LEFT, WS_EX_LEFT
    EDITTEXT        IDC_HOSTFIELD, 82, 124, 115, 14, WS_TABSTOP | ES_MULTILINE, WS_EX_LEFT
    LTEXT           "&Players:", IDC_STATIC, 27, 156, 30, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    EDITTEXT        IDC_NUMPLAYERS, 62, 154, 25, 14, WS_TABSTOP | ES_CENTER | ES_AUTOHSCROLL | ES_NUMBER, WS_EX_LEFT
    CONTROL         "", IDC_NUMPLAYERSUD, UPDOWN_CLASS, UDS_ARROWKEYS | UDS_SETBUDDYINT, 87, 154, 11, 14, WS_EX_LEFT
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_PAGE_GAME DIALOGEX 0, 0, 252, 182
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILDWINDOW
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    CONTROL         "", IDC_GAMELIST, WC_LISTVIEW, LVS_REPORT | LVS_NOSORTHEADER | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 0, 0, 252, 163
    LTEXT           "Import game data:", IDC_STATIC,             5, 170, 100, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    PUSHBUTTON      "C&hoose a location...", IDC_CHOOSEIMPORT, 115, 166, 75, 15, 0, WS_EX_LEFT
    PUSHBUTTON      "&More info", IDC_IMPORTINFO,              195, 166, 55, 15, 0, WS_EX_LEFT
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_PAGE_MESSAGES DIALOGEX 0, 0, 252, 182
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILDWINDOW
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    EDITTEXT        IDC_MESSAGES, 0, 0, 252, 182, WS_VSCROLL | NOT WS_BORDER | NOT WS_TABSTOP | ES_MULTILINE | ES_READONLY, WS_EX_LEFT
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_IMPORTINFO DIALOGEX 20, 40, 300, 150
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_CAPTION | WS_VISIBLE | WS_POPUP
CAPTION "More information"
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    DEFPUSHBUTTON   "&Close", IDOK, 240, 130, 55, 15, 0, WS_EX_LEFT
    PUSHBUTTON      "&Download Demo", IDCONTINUE, 5, 130, 80, 15, 0, WS_EX_LEFT
    LTEXT           "", IDC_IMPORTINFO_HEADER, 12, 12, 276, 18, 0, WS_EX_LEFT
    LTEXT           "", IDC_IMPORTINFO_TEXT, 12, 36, 276, 92, 0, WS_EX_LEFT
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_IMPORTSTATUS DIALOGEX 20, 40, 330, 25
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_CAPTION | WS_VISIBLE | WS_POPUP
CAPTION "Importing"
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    LTEXT "Scanning:", IDC_STATIC, 7, 9, 55, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    LTEXT "...",    IDC_IMPORTSTATUS_TEXT, 67, 9, 198, 9, NOT WS_GROUP | SS_LEFT, WS_EX_LEFT
    DEFPUSHBUTTON   "&Cancel", IDCANCEL, 270, 5, 55, 15, 0, WS_EX_LEFT
}

